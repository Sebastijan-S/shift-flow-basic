+.revenue-panel { margin-top: 0; }
+.revenue-heading { margin-bottom: 8px; }
+.revenue-heading [data-slot="button"] { min-height: 44px; }
+.revenue-panel .revenue-form { margin: 0 0 22px; padding: 16px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); scroll-margin-top: 82px; }
+.revenue-form fieldset { min-width: 0; border: 0; padding: 0; margin: 0; }
+.revenue-form legend { padding: 0; margin-bottom: 12px; font-weight: 600; font-size: 14px; }
+.revenue-fields { display: grid; grid-template-columns: minmax(150px,.9fr) repeat(2,minmax(135px,1fr)) minmax(180px,1.1fr); gap: 12px; }
+.revenue-fields label { display: flex; flex-direction: column; gap: 6px; min-width: 0; font-size: 12px; }
+.revenue-fields input { min-height: 44px; }
+.revenue-total { display: flex; justify-content: space-between; gap: 12px; border-top: 1px solid var(--border); margin-top: 16px; padding-top: 12px; font-size: 12px; color: var(--muted-foreground); }
+.revenue-total output { color: var(--foreground); font: 600 14px var(--font-mono); text-align: right; }
+.revenue-actions { display: flex; gap: 8px; flex-wrap: wrap; margin-top: 14px; }
+.revenue-actions [data-slot="button"] { min-height: 44px; }
+.revenue-summary { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 12px; margin: 0 0 24px; }
+.revenue-summary > div { padding: 16px; border: 1px solid var(--border); border-radius: 8px; min-width: 0; }
+.revenue-summary h3 { margin-bottom: 7px; }
+.revenue-summary strong { display: block; font: 600 22px var(--font-mono); letter-spacing: -.6px; font-variant-numeric: tabular-nums; }
+.revenue-summary .revenue-highlight-value { color: var(--green-text); }
+.revenue-summary p { margin: 6px 0 0; font-size: 12px; }
+.revenue-records-heading { align-items: end; margin-bottom: 8px; }
+.revenue-records-heading h3 { margin: 0; }
+.revenue-records-heading [data-slot="button"] { min-height: 44px; }
+.revenue-panel .data-table td { font-variant-numeric: tabular-nums; }
+.revenue-cell-label { display: none; }
+.revenue-unavailable p { margin-bottom: 10px; }
+@media (max-width: 1100px) { .revenue-fields { grid-template-columns: repeat(2,minmax(0,1fr)); } }
+@media (max-width: 700px) { .revenue-summary { grid-template-columns: 1fr; } }
+@media (max-width: 480px) {
+  .revenue-panel .revenue-form { padding: 14px; }
+  .revenue-fields { gap: 12px 10px; }
+  .revenue-date, .revenue-shift { grid-column: 1 / -1; }
+  .revenue-cash { grid-row: 2; grid-column: 1; }
+  .revenue-cards { grid-row: 2; grid-column: 2; }
+  .revenue-shift { grid-row: 3; }
+  .revenue-panel .data-table-scroll { overflow: visible; }
+  .revenue-panel .data-table { display: block; min-width: 0; }
+  .revenue-panel .data-table thead { position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px; overflow: hidden; clip: rect(0,0,0,0); white-space: nowrap; border: 0; }
+  .revenue-panel .data-table tbody { display: grid; gap: 10px; }
+  .revenue-panel .data-table tr { display: grid; grid-template-columns: repeat(2,minmax(0,1fr)); gap: 10px 14px; padding: 13px; border: 1px solid var(--border); border-radius: 8px; }
+  .revenue-panel .data-table td { display: flex; flex-direction: column; align-items: flex-start; gap: 2px; min-width: 0; padding: 0; border: 0; overflow-wrap: anywhere; }
+  .revenue-panel .data-table td:last-child { grid-column: 1 / -1; width: 100%; text-align: left; }
+  .revenue-panel .data-table td:last-child [data-slot="button"] { width: 100%; min-height: 44px; }
+  .revenue-panel .data-table td:nth-child(5) { font-weight: 600; }
+  .revenue-cell-label { display: block; color: var(--muted-foreground); font: 11px var(--font-mono); }
+}
 
 @media (max-width: 480px) {
   .form-columns { grid-template-columns: minmax(0, 1fr); }
