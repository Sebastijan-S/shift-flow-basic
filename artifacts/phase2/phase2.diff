-/* Notes uses the existing responsive settings form without widening its panel. */
-.notes-group { margin-top: 24px; min-width: 0; }
-.note-card { border: 1px solid var(--border); border-radius: 10px; padding: 16px; margin-top: 12px; min-width: 0; overflow-wrap: anywhere; }
-.note-card p { margin-bottom: 12px; }
-.note-text { white-space: pre-wrap; overflow-wrap: anywhere; }
-.note-actions { display: flex; flex-wrap: wrap; gap: 8px; }
-.note-overdue { border-color: #d97706; }
-.note-deadline { color: #d97706; }
+/* Notes keeps due work first and opens its editor only when requested. */
+.notes-panel { margin-top: 0; }
+.notes-heading { margin-bottom: 20px; }
+.notes-heading-actions, .notes-editor-actions, .note-actions { display: flex; flex-wrap: wrap; gap: 8px; }
+.notes-heading-actions [data-slot="button"], .notes-editor-actions [data-slot="button"], .note-actions [data-slot="button"] { min-height: 44px; height: auto; }
+.notes-panel .notes-editor { margin: 0 0 22px; padding: 16px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); scroll-margin-top: 82px; }
+.notes-editor h2 { margin-bottom: 0; font-size: 15px; }
+.notes-editor fieldset { min-width: 0; border: 0; padding: 0; margin: 0; display: grid; gap: 14px; }
+.notes-editor .form-columns > label { display: flex; flex-direction: column; gap: 6px; min-width: 0; font-size: 12px; }
+.notes-editor-actions { margin-top: 2px; }
+.notes-group { min-width: 0; margin-top: 24px; }
+.notes-active { margin-top: 0; }
+.notes-group + .notes-group { padding-top: 22px; border-top: 1px solid var(--border); }
+.notes-group-heading { display: flex; align-items: baseline; gap: 9px; margin-bottom: 10px; }
+.notes-group-heading h2 { margin: 0; font-size: 15px; }
+.notes-group-heading span { font: 12px var(--font-mono); color: var(--muted-foreground); }
+.notes-empty { margin: 0; padding: 18px; border: 1px dashed var(--border); border-radius: 8px; color: var(--muted-foreground); font-size: 13px; }
+.note-card { display: grid; grid-template-columns: minmax(0, 1fr) auto; grid-template-areas: "text actions" "meta actions" "confirm confirm"; align-items: center; gap: 4px 16px; min-width: 0; margin-top: 9px; padding: 15px; border: 1px solid var(--border); border-radius: 8px; background: var(--surface); overflow-wrap: anywhere; }
+.note-text { grid-area: text; margin: 0; white-space: pre-wrap; overflow-wrap: anywhere; font-size: 14px; line-height: 1.55; }
+.note-meta { grid-area: meta; display: flex; align-items: center; flex-wrap: wrap; gap: 7px 10px; color: var(--muted-foreground); font: 11px var(--font-mono); }
+.note-actions { grid-area: actions; }
+.note-meta time { overflow-wrap: anywhere; }
+.note-deadline, .note-completed { display: inline-block; padding: 3px 6px; border-radius: 4px; font: 600 11px var(--font-sans); }
+.note-deadline { color: #e8ae65; background: #b8754524; }
+.note-completed { color: var(--mint-fg); background: var(--mint-bg); }
+.note-overdue { border-color: #b87545; }
+.note-complete-action[data-slot="button"] { color: var(--mint-fg); border-color: var(--mint-border); background: var(--mint-bg); }
+.note-reopen-action[data-slot="button"] { color: var(--blue-fg); border-color: var(--blue-border); background: var(--blue-bg); }
+.note-delete-action[data-slot="button"] { color: var(--destructive); }
+.note-delete-confirm { grid-area: confirm; margin-top: 9px; padding: 12px; border: 1px solid var(--border); border-radius: 6px; }
+.note-delete-confirm p { margin-bottom: 8px; font-size: 12px; }
+@media (max-width: 480px) {
+  .notes-heading-actions { width: 100%; }
+  .notes-heading-actions [data-slot="button"]:first-child { flex: 1; }
+  .notes-editor { padding: 14px; }
+  .note-card { display: block; }
+  .note-text { margin-bottom: 10px; }
+  .note-meta { margin-bottom: 13px; }
+  .note-actions [data-slot="button"] { flex: 1 1 auto; }
+}
 
 /* Each wide table owns its scroll; forms remain within the mobile panel. */
 .bar-panel, .bar-editor, .bar-item-form { min-width: 0; max-width: 100%; }
