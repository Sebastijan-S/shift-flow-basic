defaultValue={w.rules.maxWeeklyHours} required /><span>sati</span></div></label><label>Primena maksimuma sati<select aria-describedby="hours-severity-help" name="hoursSeverity" defaultValue={w.rules.hoursSeverity}><option value="block">Zabrana</option><option value="warning">Upozorenje</option></select></label></div><p id="hours-severity-help" className="work-rule-help">Zabrana blokira prekoračenje fonda. Upozorenje dozvoljava izmenu i prikazuje upozorenje. Poseban maksimum zaposlenog ima prednost nad ovim fondom.</p></fieldset><fieldset className="work-rule-group"><legend>Smene u istom danu</legend><label className="check-row"><input type="checkbox" name="multiple" defaultChecked={w.rules.allowMultiple} /><span>Dozvoli više smena dnevno<small>Više smena istog dana prikazuje upozorenje. Preklapanje termina je uvek zabranjeno.</small></span></label></fieldset><Button type="submit">Sačuvaj pravila</Button></form></section><section className="panel"><h2>Potreban broj ljudi</h2><p className="muted">Podesite broj zaposlenih po danu, smeni i poziciji.</p><p className="settings-auto-label">Promene broja ljudi čuvaju se odmah.</p><div className="requirements-editor">{DAY_NAMES.map((name, dayIndex) => <details key={name} open={dayIndex === 0}><summary>{name}<RiArrowDownSLine size={16} /></summary>{w.templates.map(t => <div key={t.id} className="requirement-row"><strong>{t.name}<small>{t.start}–{t.end}</small></strong>{positions.map(p => <label key={p}>{p}<input type="number" min="0" max="20" aria-label={`${name}, ${t.name}, ${p}`} value={w.requirements.find(r => r.day === dayIndex && r.templateId === t.id && r.position === p)?.count ?? 0} onChange={e => { const count = Math.max(0, Math.min(20, Number(e.target.value))); const rest = w.requirements.filter(r => !(r.day === dayIndex && r.templateId === t.id && r.position === p)); commit({ ...w, requirements: [...rest, { day: dayIndex, templateId: t.id, position: p, count }] }, "Promenjene potrebe tima"); }} /></label>)}</div>)}</details>)}</div></section></div>}
 
       {page === "Istorija izmena" && <section className="panel"><div className="panel-heading"><h2>Sačuvane promene <span className="tag">{state.past.length}</span></h2><div className="heading-actions"><Button variant="outline" disabled={!state.past.length} onClick={undo}><RiArrowGoBackLine size={16} />Poništi</Button><Button variant="outline" disabled={!state.future.length} onClick={redo}><RiArrowGoForwardLine size={16} />Ponovi</Button></div></div>{!state.past.length ? <Empty>Vaše izmene će se pojaviti ovde. Istorija ostaje sačuvana i posle zatvaranja pregledača.</Empty> : <div className="history-list">{[...state.past].reverse().map((entry, i) => <div key={i}><span className="history-icon"><RiHistoryLine size={17} /></span><span><strong>{entry.label}</strong><small>{new Date(entry.time).toLocaleString("sr-Latn-RS", { timeZone: "Europe/Belgrade", dateStyle: "medium", timeStyle: "short" })}</small></span>{i === 0 && <span className="tag">Poslednja izmena</span>}</div>)}</div>}</section>}
 
