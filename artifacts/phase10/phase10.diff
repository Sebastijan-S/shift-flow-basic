   .basic-rows > div > span:first-child { min-width: 0; flex-basis: 100%; }
 }
 
+/* Work rules keep the switch, limit and consequence in one group. */
+.work-rules > .panel { min-width: 0; }
+.work-rules .work-rule-group { min-width: 0; margin: 0; padding: 0 0 20px; border: 0; border-bottom: 1px solid var(--border); }
+.work-rules .work-rule-group legend { padding: 0; font: 600 14px var(--font-sans); }
+.work-rules .rule-field { padding: 0; border: 0; grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); align-items: end; }
+.work-rules .rule-field > label { min-width: 0; }
+.work-rules .input-unit > span { flex-shrink: 0; white-space: nowrap; font: 12px var(--font-mono); }
+.work-rules .work-rule-help, .work-rules .check-row small { color: var(--muted-foreground); font: 12px/1.7 var(--font-sans); }
+.work-rules .work-rule-help { margin: 12px 0 0; }
+.work-rules .check-row { min-height: 44px; }
+.work-rules .requirements-editor summary { min-height: 44px; }
+.work-rules .requirement-row strong { min-width: 100px; overflow-wrap: anywhere; }
+.work-rules .requirement-row label { overflow-wrap: anywhere; }
+@media (max-width: 480px) {
+  .work-rules .rule-field { grid-template-columns: minmax(0, 1fr); }
+  .work-rules .requirement-row strong { flex-basis: 100%; }
+  .work-rules .requirement-row label { flex: 1 1 76px; }
+  .work-rules .requirement-row input { min-height: 44px; }
+  .work-rules .settings-form > [data-slot="button"] { width: 100%; min-height: 44px; }
+}
+
 /* Notes keeps due work first and opens its editor only when requested. */
 .notes-panel { margin-top: 0; }
 .notes-heading { margin-bottom: 20px; }
